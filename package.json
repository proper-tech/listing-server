{
  "name": "listing-server",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "үл хөдлөх хөрөнгийн зарын сайтын API (Cloudflare Workers + Hono, D1, R2)",
  "scripts": {
    "dev": "wrangler dev --port 4000 --var ENVIRONMENT:local",
    "dev:remote": "wrangler dev --remote --port 4000",
    "deploy:testing": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:testing": "wrangler d1 migrations apply DB --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "agent:create": "node scripts/create-agent.ts"
  },
  "dependencies": {
    "@phi-ag/argon2": "^0.6.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
