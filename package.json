{
  "name": "ger360-api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Гэр360 — үл хөдлөх хөрөнгийн зарын сайтын API (Cloudflare Workers + Hono, Neon Postgres, R2)",
  "scripts": {
    "dev": "wrangler dev --port 4000",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:local": "node -e \"require('fs').mkdirSync('data',{recursive:true})\" && pglite-server --db=./data/pglite --port=5433 --max-connections=10",
    "db:migrate": "node scripts/migrate.ts",
    "import:local": "node scripts/import-data.ts --local",
    "import:remote": "node scripts/import-data.ts --remote"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "postgres": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
