{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // ---------- testing (анхдагч): `npm run dev`, `npm run deploy:testing` ----------
  "name": "listing-server-api-testing",
  // COOKIE_SAMESITE: вэб (vercel.app), API (workers.dev) өөр site тул "None".
  // Хоёуланг нэг домэйнд (жишээ нь example.mn + api.example.mn) оруулмагц "Lax" болгоно.
  // QPay: QPAY_MODE mock | sandbox | live (src/qpay.ts). Нууц утгууд: `wrangler secret put QPAY_USERNAME` гэх мэт.
  // testing: mock — QPay-гүйгээр бүх урсгалыг туршина ("Туршилтын төлбөр" товч). Sandbox түлхүүр авмагц "sandbox" болгоно.
  "vars": {
    "ENVIRONMENT": "testing",
    "COOKIE_SAMESITE": "None",
    "QPAY_MODE": "mock",
    "QPAY_INVOICE_CODE": "",
    "PUBLIC_API_URL": "https://listing-server-api-testing.badralbaigalmaa7.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "listing-server-testing",
      "database_id": "3c3c6051-b29c-4e4b-a14f-627d9fc864f1",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "listing-server-testing" },
  ],

  "env": {
    // ---------- production: `npm run deploy:production` (--env production) ----------
    // Binding-ууд өвлөгддөггүй тул энд дахин бичнэ.
    "production": {
      "name": "listing-server-api",
      // TODO: нэг домэйн авмагц "Lax" болгох
      // live: жинхэнэ мөнгө. QPAY_INVOICE_CODE болон secret-үүдийг (QPAY_USERNAME, QPAY_PASSWORD, QPAY_CALLBACK_SECRET)
      // тавихаас өмнө агентууд зар төлж чадахгүй (503).
      "vars": {
        "ENVIRONMENT": "production",
        "COOKIE_SAMESITE": "None",
        "QPAY_MODE": "live",
        "QPAY_INVOICE_CODE": "",
        "PUBLIC_API_URL": "https://listing-server-api.badralbaigalmaa7.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "listing-server-production",
          "database_id": "8758b2f4-0370-4173-9c28-226979ec8c25",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "listing-server-production" },
      ],
    },
  },
}
